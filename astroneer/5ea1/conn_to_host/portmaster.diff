 }
+
+// go test -v -run TestEndpointMatchingDomainNormalization ./service/profile/endpoints
+func TestEndpointMatchingDomainNormalization(t *testing.T) {
+	t.Parallel()
+
+	ep, err := parseEndpoint("+ 5ea1.playfabapi.com")
+	assert.NoError(t, err)
+
+	// Uppercase input without trailing dot
+	entity := (&intel.Entity{
+		Domain: "5EA1.PLAYFABAPI.COM",
+	}).Init(0)
+	testEndpointMatch(t, ep, entity, Permitted)
+
+	// Uppercase input with trailing dot
+	entity2 := (&intel.Entity{
+		Domain: "5EA1.PLAYFABAPI.COM.",
+	}).Init(0)
+	testEndpointMatch(t, ep, entity2, Permitted)
+
+	// Test lowercase input without trailing dot
+	entityFQDN := (&intel.Entity{
+		Domain: "5ea1.playfabapi.com",
+	}).Init(0)
+	testEndpointMatch(t, ep, entityFQDN, Permitted)
+
+	// Test lowercase input with trailing dot
+	entityFQDN2 := (&intel.Entity{
+		Domain: "5ea1.playfabapi.com.",
+	}).Init(0)
+	testEndpointMatch(t, ep, entityFQDN2, Permitted)
+
+	// CNAME match producing Permitted decision
+	entityCNAME := (&intel.Entity{
+		Domain: "some-other-domain.com.",
+		CNAME:  []string{"5ea1.playfabapi.com."},
+	}).Init(0)
+	entityCNAME.EnableCNAMECheck(context.Background(), true)
+
+	testEndpointMatch(t, ep, entityCNAME, Permitted)
+}
